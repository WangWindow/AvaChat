<Window
    x:Class="AvaChat.Server.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AvaChat.Server.ViewModels"
    Title="AvaChat 服务器"
    MinWidth="600"
    MinHeight="500"
    d:DesignHeight="600"
    d:DesignWidth="900"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    TransparencyLevelHint="AcrylicBlur"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.Header">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
        </Style>

        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BoxShadow" Value="0 2 10 0 #15000000" />
        </Style>
    </Window.Styles>

    <Grid>
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    MaterialOpacity="0.65"
                    TintColor="{DynamicResource SystemChromeMediumColor}"
                    TintOpacity="1" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <Grid Margin="15" RowDefinitions="Auto,*">
            <!--  头部状态栏  -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,15"
                Padding="15,10"
                Classes="Card">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="15">
                        <TextBlock VerticalAlignment="Center" Text="服务器状态: " />
                        <Border
                            Padding="8,3"
                            Background="{DynamicResource SystemControlHighlightAccentBrush}"
                            CornerRadius="4">
                            <TextBlock Foreground="White" Text="运行中" />
                        </Border>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="15">
                        <TextBlock VerticalAlignment="Center" Text="{Binding ServerStats}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  主内容区  -->
            <Grid Grid.Row="1" ColumnDefinitions="250,*">

                <!--  左侧面板  -->
                <Border
                    Grid.Column="0"
                    Margin="0,0,15,0"
                    Padding="15"
                    Classes="Card">

                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock
                            Grid.Row="0"
                            Classes="Header"
                            Text="在线用户" />

                        <ListBox
                            Grid.Row="1"
                            ItemsSource="{Binding OnlineUsers}"
                            SelectedItem="{Binding SelectedUser}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding}">
                                        <Ellipse
                                            Width="8"
                                            Height="8"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Fill="{DynamicResource SystemControlHighlightAccentBrush}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel
                            Grid.Row="2"
                            Margin="0,10,0,0"
                            Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="在线用户: " />
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding OnlineUsers.Count}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  右侧消息区  -->
                <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

                    <!--  系统消息标题  -->
                    <Border
                        Grid.Row="0"
                        Margin="0,0,0,15"
                        Padding="15,10"
                        Classes="Card">
                        <TextBlock
                            Margin="0"
                            Classes="Header"
                            Text="系统消息" />
                    </Border>

                    <!--  消息记录  -->
                    <Border
                        Grid.Row="1"
                        Margin="0,0,0,15"
                        Padding="15"
                        Classes="Card">
                        <ScrollViewer x:Name="MessagesScroller" VerticalScrollBarVisibility="Auto">
                            <TextBox
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                IsReadOnly="True"
                                Text="{Binding SystemMessages}"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <!--  消息输入区  -->
                    <Border
                        Grid.Row="2"
                        Padding="10"
                        Classes="Card">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox
                                Grid.Column="0"
                                Padding="10,5"
                                Text="{Binding MessageToSend}"
                                Watermark="输入系统广播消息..." />

                            <Button
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Padding="15,8"
                                Classes="Primary"
                                Command="{Binding SendSystemMessageCommand}">
                                <TextBlock Text="广播消息" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
