<UserControl
    x:Class="AvaChat.Client.Views.ChatView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AvaChat.Client.ViewModels"
    d:DesignHeight="800"
    d:DesignWidth="600"
    x:DataType="vm:ChatViewModel"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:ChatViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto">
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}">
            <Grid>
                <!--  未选择好友时的提示  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding CurrentFriend, Converter={StaticResource NullToVisibilityConverter}}"
                    Spacing="16">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="16"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Text="选择一个好友开始聊天" />
                </StackPanel>

                <!--  消息列表  -->
                <ScrollViewer
                    Name="MessageScrollViewer"
                    Padding="20"
                    IsVisible="{Binding CurrentFriend, Converter={StaticResource NotNullToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--  消息气泡  -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  接收的消息（左侧）  -->
                                    <Border
                                        Grid.Column="0"
                                        Margin="0,0,80,0"
                                        Padding="12,8"
                                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                        CornerRadius="12,12,12,4"
                                        IsVisible="{Binding SenderId, Converter={StaticResource IsNotCurrentUserConverter}}">
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                FontSize="14"
                                                Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                Text="{Binding Content}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!--  发送的消息（右侧）  -->
                                    <Border
                                        Grid.Column="2"
                                        Margin="80,0,0,0"
                                        Padding="12,8"
                                        Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                        CornerRadius="12,12,4,12"
                                        IsVisible="{Binding SenderId, Converter={StaticResource IsCurrentUserConverter}}">
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                FontSize="14"
                                                Foreground="White"
                                                Text="{Binding Content}"
                                                TextWrapping="Wrap" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!--  消息状态图标  -->
                                                <Path
                                                    Grid.Column="1"
                                                    Width="12"
                                                    Height="12"
                                                    Margin="4,0,0,0"
                                                    Data="{Binding Status, Converter={StaticResource MessageStatusIconConverter}}"
                                                    Fill="#CCFFFFFF" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!--  底部输入区域  -->
        <Border
            Grid.Row="1"
            Padding="20,12"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0"
            IsVisible="{Binding CurrentFriend, Converter={StaticResource NotNullToVisibilityConverter}}">

            <Grid RowDefinitions="Auto,Auto">
                <!--  输入框和发送按钮  -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

                    <!--  输入框  -->
                    <Border
                        Grid.Column="0"
                        Padding="16,8"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="20">
                        <TextBox
                            MaxHeight="100"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="14"
                            Text="{Binding MessageText}"
                            TextWrapping="Wrap"
                            Watermark="输入消息... (Enter换行，Ctrl+Enter发送)">
                            <TextBox.KeyBindings>
                                <KeyBinding Command="{Binding SendMessageCommand}" Gesture="Ctrl+Return" />
                            </TextBox.KeyBindings>
                        </TextBox>
                    </Border>

                    <!--  发送按钮  -->
                    <Button
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        Margin="12,0,0,0"
                        Background="{DynamicResource SystemControlHighlightAccentBrush}"
                        Command="{Binding SendMessageCommand}"
                        CornerRadius="20"
                        IsEnabled="{Binding !IsSending}"
                        ToolTip.Tip="发送消息">
                        <Grid>
                            <!--  发送图标  -->
                            <Path
                                Width="16"
                                Height="16"
                                Data="M2,21L23,12L2,3V10L17,12L2,14V21Z"
                                Fill="White"
                                IsVisible="{Binding !IsSending}" />

                            <!--  发送中动画  -->
                            <Border
                                Width="16"
                                Height="16"
                                Background="White"
                                CornerRadius="8"
                                IsVisible="{Binding IsSending}">
                                <Border.RenderTransform>
                                    <RotateTransform />
                                </Border.RenderTransform>
                                <Border.Styles>
                                    <Style Selector="Border">
                                        <Style.Animations>
                                            <Animation IterationCount="Infinite" Duration="0:0:1">
                                                <KeyFrame Cue="0%">
                                                    <Setter Property="(RotateTransform.Angle)" Value="0" />
                                                </KeyFrame>
                                                <KeyFrame Cue="100%">
                                                    <Setter Property="(RotateTransform.Angle)" Value="360" />
                                                </KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </Border.Styles>
                            </Border>
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
