<Window
    x:Class="AvaChat.Client.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:AvaChat.Client.Views"
    xmlns:vm="using:AvaChat.Client.ViewModels"
    Title="AvaChat"
    Width="880"
    Height="560"
    MinWidth="800"
    MinHeight="600"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!--  双栏布局：好友列表 + 聊天窗口  -->
    <Grid ColumnDefinitions="220,*">

        <!--  左侧好友列表区域  -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,1,0">
            <Grid RowDefinitions="*,Auto">
                <!--  好友列表视图  -->
                <views:FriendListView Grid.Row="0" DataContext="{Binding FriendListViewModel}" />

                <!--  底部状态栏  -->
                <Border
                    Grid.Row="1"
                    Padding="12,8"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <!--  设置按钮  -->
                        <Button
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding ShowSettingsCommand}"
                            CornerRadius="16"
                            ToolTip.Tip="设置">
                            <PathIcon
                                Width="16"
                                Height="16"
                                Data="M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10M10,22C9.75,22 9.54,21.82 9.5,21.58L9.13,18.93C8.5,18.68 7.96,18.34 7.44,17.94L4.95,18.95C4.73,19.03 4.46,18.95 4.34,18.73L2.34,15.27C2.21,15.05 2.27,14.78 2.46,14.63L4.57,12.97L4.5,12L4.57,11.03L2.46,9.37C2.27,9.22 2.21,8.95 2.34,8.73L4.34,5.27C4.46,5.05 4.73,4.96 4.95,5.05L7.44,6.05C7.96,5.66 8.5,5.32 9.13,5.07L9.5,2.42C9.54,2.18 9.75,2 10,2H14C14.25,2 14.46,2.18 14.5,2.42L14.87,5.07C15.5,5.32 16.04,5.66 16.56,6.05L19.05,5.05C19.27,4.96 19.54,5.05 19.66,5.27L21.66,8.73C21.79,8.95 21.73,9.22 21.54,9.37L19.43,11.03L19.5,12L19.43,12.97L21.54,14.63C21.73,14.78 21.79,15.05 21.66,15.27L19.66,18.73C19.54,18.95 19.27,19.04 19.05,18.95L16.56,17.95C16.04,18.34 15.5,18.68 14.87,18.93L14.5,21.58C14.46,21.82 14.25,22 14,22H10M11.25,4L10.88,6.61C9.68,6.86 8.62,7.5 7.85,8.39L5.44,7.35L4.69,8.65L6.8,10.2C6.4,11.37 6.4,12.64 6.8,13.8L4.68,15.36L5.43,16.66L7.86,15.62C8.63,16.5 9.68,17.14 10.87,17.38L11.24,20H12.76L13.13,17.39C14.32,17.14 15.37,16.5 16.14,15.62L18.57,16.66L19.32,15.36L17.2,13.81C17.6,12.64 17.6,11.37 17.2,10.2L19.31,8.65L18.56,7.35L16.15,8.39C15.38,7.5 14.32,6.86 13.12,6.62L12.75,4H11.25Z"
                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </Button>

                        <!--  用户状态信息  -->
                        <StackPanel
                            Grid.Column="1"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{Binding CurrentUserName}" />
                            <TextBlock
                                FontSize="10"
                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                Text="{Binding UserStatus}" />
                        </StackPanel>

                        <!--  系统通知按钮  -->
                        <Button
                            Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding ShowNotificationsCommand}"
                            CornerRadius="16"
                            ToolTip.Tip="系统通知">
                            <Grid>
                                <PathIcon
                                    Width="16"
                                    Height="16"
                                    Data="M16,17H7V10.5C7,8 9,6 11.5,6C14,6 16,8 16,10.5M18,16V10.5C18,7.43 15.86,4.86 13,4.18V3.5A1.5,1.5 0 0,0 11.5,2A1.5,1.5 0 0,0 10,3.5V4.18C7.14,4.86 5,7.43 5,10.5V16L3,18V19H20V18M11.5,22A2,2 0 0,0 13.5,20H9.5A2,2 0 0,0 11.5,22Z"
                                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                                <!--  新通知指示器  -->
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    Margin="0,-4,-4,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Fill="Red"
                                    IsVisible="{Binding HasNewNotifications}" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!--  右侧聊天窗口  -->
        <Border Grid.Column="1" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <views:ChatView DataContext="{Binding ChatViewModel}" />
        </Border>
    </Grid>
</Window>
