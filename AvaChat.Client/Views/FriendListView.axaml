<UserControl
    x:Class="AvaChat.Client.Views.FriendListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AvaChat.Client.ViewModels"
    d:DesignHeight="800"
    d:DesignWidth="300"
    x:DataType="vm:FriendListViewModel"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:FriendListViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!--  顶部标题栏  -->
        <Border
            Grid.Row="0"
            Padding="16,12"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="好友列表" />
                <Button
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding AddFriendCommand}"
                    ToolTip.Tip="添加好友">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                        Text="+" />
                </Button>
            </Grid>
        </Border>

        <!--  搜索框  -->
        <Border
            Grid.Row="1"
            Padding="16,8"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <TextBox
                Padding="12,8"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Text="{Binding SearchText}"
                Watermark="搜索好友...">
                <TextBox.InnerLeftContent>
                    <Path
                        Width="16"
                        Height="16"
                        Margin="8,0,4,0"
                        Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                        Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </TextBox.InnerLeftContent>
            </TextBox>
        </Border>

        <!--  好友列表  -->
        <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <Grid>
                <!--  加载状态  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsLoading}"
                    Spacing="16">
                    <Border
                        Width="32"
                        Height="32"
                        Background="{DynamicResource SystemControlHighlightAccentBrush}"
                        CornerRadius="16">
                        <Border.RenderTransform>
                            <RotateTransform />
                        </Border.RenderTransform>
                        <Border.Styles>
                            <Style Selector="Border">
                                <Style.Animations>
                                    <Animation IterationCount="Infinite" Duration="0:0:1">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="(RotateTransform.Angle)" Value="0" />
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="(RotateTransform.Angle)" Value="360" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Border.Styles>
                    </Border>
                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="正在加载好友列表..." />
                </StackPanel>

                <!--  好友列表  -->
                <ScrollViewer IsVisible="{Binding !IsLoading}">
                    <ItemsControl ItemsSource="{Binding FilteredFriends}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--  好友项  -->
                                <Border
                                    Padding="16,8"
                                    Background="Transparent"
                                    Cursor="Hand">
                                    <Border.Styles>
                                        <Style Selector="Border:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
                                        </Style>
                                    </Border.Styles>

                                    <i:Interaction.Behaviors>
                                        <ia:EventTriggerBehavior EventName="Tapped">
                                            <ia:InvokeCommandAction Command="{Binding $parent[ItemsControl].((vm:FriendListViewModel)DataContext).SendMessageCommand}" CommandParameter="{Binding}" />
                                        </ia:EventTriggerBehavior>
                                    </i:Interaction.Behaviors>

                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Command="{Binding $parent[ItemsControl].((vm:FriendListViewModel)DataContext).RemoveFriendCommand}"
                                                CommandParameter="{Binding}"
                                                Header="删除好友" />
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!--  头像和状态  -->
                                        <Grid
                                            Grid.Column="0"
                                            Width="40"
                                            Height="40">
                                            <!--  头像  -->
                                            <Border
                                                Width="40"
                                                Height="40"
                                                Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                                CornerRadius="20">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    Text="{Binding FriendUser.UserName, Converter={StaticResource FirstCharConverter}}" />
                                            </Border>

                                            <!--  在线状态指示器  -->
                                            <Border
                                                Width="12"
                                                Height="12"
                                                Margin="0,0,-2,-2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Background="{Binding FriendUser.Status, Converter={StaticResource StatusColorConverter}}"
                                                BorderBrush="White"
                                                BorderThickness="2"
                                                CornerRadius="6" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--  空状态  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding FilteredFriends.Count, Converter={StaticResource ZeroToVisibilityConverter}}"
                    Spacing="16">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Text="暂无好友" />
                    <Button
                        HorizontalAlignment="Center"
                        Command="{Binding AddFriendCommand}"
                        Content="添加好友" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  底部操作栏  -->
        <Border
            Grid.Row="3"
            Padding="16,8"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    Text="{Binding FilteredFriends.Count, StringFormat='共 {0} 个好友'}" />
                <Button
                    Grid.Column="1"
                    Padding="8,4"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding RefreshCommand}"
                    Content="刷新"
                    FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
