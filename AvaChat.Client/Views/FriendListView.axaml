<UserControl
    x:Class="AvaChat.Client.Views.FriendListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AvaChat.Client.ViewModels"
    d:DesignHeight="800"
    d:DesignWidth="300"
    x:DataType="vm:FriendListViewModel"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:FriendListViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*">

        <!--  顶部标题栏  -->
        <Border
            Grid.Row="0"
            Padding="16,12"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="好友列表" />
                    <!--  刷新好友列表  -->
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding RefreshCommand}"
                        CornerRadius="18"
                        ToolTip.Tip="刷新">
                        <PathIcon
                            Width="16"
                            Height="16"
                            Data="M12,2 C17.5228,2 22,6.47715 22,12 C22,17.5228 17.5228,22 12,22 C6.47715,22 2,17.5228 2,12 C2,6.47715 6.47715,2 12,2 Z M12,3.5 C7.30558,3.5 3.5,7.30558 3.5,12 C3.5,16.6944 7.30558,20.5 12,20.5 C16.6944,20.5 20.5,16.6944 20.5,12 C20.5,7.30558 16.6944,3.5 12,3.5 Z M16.75,12 C17.1296833,12 17.4434889,12.2821653 17.4931531,12.6482323 L17.5,12.75 L17.5,15.75 C17.5,16.1642 17.1642,16.5 16.75,16.5 C16.3703167,16.5 16.0565111,16.2178347 16.0068469,15.8517677 L16,15.75 L16,15 C15.0881,16.2143 13.6362,17 11.9999,17 C10.4748,17 9.09587,16.316 8.17857,15.237 C7.91028,14.9214 7.94862,14.4481 8.2642,14.1798 C8.57979,13.9115 9.05311,13.9499 9.3214,14.2655 C9.96322,15.0204 10.9293,15.5 11.9999,15.5 C13.32553,15.5 14.4803167,14.7625672 15.0742404,13.6746351 L15.1633,13.5 L14,13.5 C13.5858,13.5 13.25,13.1642 13.25,12.75 C13.25,12.3703167 13.5321653,12.0565111 13.8982323,12.0068469 L14,12 L16.75,12 Z M11.9999,7 C13.5368,7 14.9041,7.66036 15.8268,8.77062 C16.0915,9.08918 16.0479,9.56205 15.7294,9.8268 C15.4108,10.0916 14.9379,10.0479 14.6732,9.72938 C14.0368,8.96361 13.093,8.5 11.9999,8.5 C10.5754318,8.5 9.34895806,9.35140335 8.80281957,10.5730172 L8.72948,10.75 L10,10.75 C10.4142,10.75 10.75,11.0858 10.75,11.5 C10.75,11.8796833 10.4678347,12.1934889 10.1017677,12.2431531 L10,12.25 L7.25,12.25 C6.8703075,12.25 6.55650958,11.9678347 6.50684668,11.6017677 L6.5,11.5 L6.5,8.25 C6.5,7.83579 6.83579,7.5 7.25,7.5 C7.6296925,7.5 7.94349042,7.78215688 7.99315332,8.14823019 L8,8.25 L8,8.99955 C8.9121,7.78531 10.364,7 11.9999,7 Z"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </Button>
                </StackPanel>
                <!--  添加好友按钮  -->
                <Button
                    Grid.Column="2"
                    Width="36"
                    Height="36"
                    Padding="6"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding AddFriendCommand}"
                    CornerRadius="18"
                    ToolTip.Tip="添加好友">
                    <PathIcon
                        Width="16"
                        Height="16"
                        Data="M12 7C12.4142 7 12.75 7.33579 12.75 7.75V11.25H16.25C16.6642 11.25 17 11.5858 17 12C17 12.4142 16.6642 12.75 16.25 12.75H12.75V16.25C12.75 16.6642 12.4142 17 12 17C11.5858 17 11.25 16.6642 11.25 16.25V12.75H7.75C7.33579 12.75 7 12.4142 7 12C7 11.5858 7.33579 11.25 7.75 11.25H11.25V7.75C11.25 7.33579 11.5858 7 12 7Z M3 6.25C3 4.45507 4.45507 3 6.25 3H17.75C19.5449 3 21 4.45507 21 6.25V17.75C21 19.5449 19.5449 21 17.75 21H6.25C4.45507 21 3 19.5449 3 17.75V6.25ZM6.25 4.5C5.2835 4.5 4.5 5.2835 4.5 6.25V17.75C4.5 18.7165 5.2835 19.5 6.25 19.5H17.75C18.7165 19.5 19.5 18.7165 19.5 17.75V6.25C19.5 5.2835 18.7165 4.5 17.75 4.5H6.25Z"
                        Foreground="White" />
                </Button>
            </Grid>
        </Border>

        <!--  搜索框  -->
        <Border
            Grid.Row="1"
            Padding="16,8"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <TextBox
                Padding="12,8"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Text="{Binding SearchText}"
                Watermark="搜索好友...">
                <TextBox.InnerLeftContent>
                    <Path
                        Width="16"
                        Height="16"
                        Margin="8,0,4,0"
                        Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                        Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </TextBox.InnerLeftContent>
            </TextBox>
        </Border>

        <!--  好友列表  -->
        <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <Grid>
                <!--  好友列表  -->
                <ScrollViewer IsVisible="{Binding !IsLoading}">
                    <ItemsControl ItemsSource="{Binding FilteredFriends}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--  好友项  -->
                                <Border
                                    Margin="8,2"
                                    Padding="12,12"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="8"
                                    Cursor="Hand"
                                    ToolTip.Tip="{Binding FriendUser.LastLoginTime, StringFormat='上次登录：{0:yyyy-MM-dd HH:mm:ss}'}">
                                    <Border.Styles>
                                        <Style Selector="Border:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
                                        </Style>
                                    </Border.Styles>

                                    <i:Interaction.Behaviors>
                                        <ia:EventTriggerBehavior EventName="Tapped">
                                            <ia:InvokeCommandAction Command="{Binding $parent[ItemsControl].((vm:FriendListViewModel)DataContext).SendMessageCommand}" CommandParameter="{Binding}" />
                                        </ia:EventTriggerBehavior>
                                    </i:Interaction.Behaviors>

                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Command="{Binding $parent[ItemsControl].((vm:FriendListViewModel)DataContext).RemoveFriendCommand}"
                                                CommandParameter="{Binding}"
                                                Header="删除好友" />
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid ColumnDefinitions="Auto,*">
                                        <!--  头像和状态  -->
                                        <Grid
                                            Grid.Column="0"
                                            Width="44"
                                            Height="44">
                                            <!--  头像  -->
                                            <Border
                                                Width="44"
                                                Height="44"
                                                Background="{Binding FriendUser.UserName, Converter={StaticResource AvatarColorConverter}}"
                                                CornerRadius="22">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    Text="{Binding FriendUser.UserName, Converter={StaticResource FirstCharConverter}}" />
                                            </Border>
                                            <!--  在线状态指示器  -->
                                            <Border
                                                Width="12"
                                                Height="12"
                                                Margin="0,0,-2,-2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Background="{Binding FriendUser.Status, Converter={StaticResource StatusColorConverter}}"
                                                BorderBrush="White"
                                                BorderThickness="2"
                                                CornerRadius="6" />
                                        </Grid>
                                        <!--  好友信息  -->
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                Text="{Binding FriendUser.UserName}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                Text="{Binding FriendUser.Status, Converter={StaticResource StatusTextConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--  空状态  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding FilteredFriends.Count, Converter={StaticResource ZeroToVisibilityConverter}}"
                    Spacing="16">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Text="暂无好友" />
                    <Button
                        Padding="16,8"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource SystemControlHighlightAccentBrush}"
                        Command="{Binding AddFriendCommand}"
                        CornerRadius="20"
                        Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon
                                Width="16"
                                Height="16"
                                Data="M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                Foreground="White" />
                            <TextBlock FontWeight="SemiBold" Text="添加第一个好友" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
