<UserControl
    x:Class="AvaChat.Client.Views.NavigationView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AvaChat.Client.ViewModels"
    d:DesignHeight="800"
    d:DesignWidth="60"
    x:DataType="vm:NavigationViewModel"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:NavigationViewModel />
    </Design.DataContext>

    <Grid Margin="8" RowDefinitions="Auto,*,Auto">

        <!--  顶部用户头像区域  -->
        <Border
            Grid.Row="0"
            Width="40"
            Height="40"
            Margin="0,8,0,16"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            CornerRadius="20">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding ShowProfileCommand}" Header="查看资料" />
                    <MenuItem Command="{Binding ChangeStatusCommand}" Header="更改状态" />
                    <Separator />
                    <MenuItem Header="退出登录" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!--  头像  -->
                <Ellipse Fill="{DynamicResource SystemControlHighlightAccentBrush}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding CurrentUser.Nickname, Converter={StaticResource FirstCharConverter}}" />

                <!--  在线状态指示器  -->
                <Border
                    Width="12"
                    Height="12"
                    Margin="0,0,-2,-2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{Binding CurrentUser.Status, Converter={StaticResource StatusColorConverter}}"
                    BorderBrush="White"
                    BorderThickness="2"
                    CornerRadius="6" />
            </Grid>
        </Border>

        <!--  中间导航按钮区域  -->
        <StackPanel Grid.Row="1" Spacing="8">

            <!--  聊天按钮  -->
            <Border
                Width="44"
                Height="44"
                Background="{Binding CurrentNavigation, Converter={StaticResource NavigationBackgroundConverter}, ConverterParameter=Chat}"
                CornerRadius="8">
                <Button
                    Width="44"
                    Height="44"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding SwitchToChatCommand}"
                    ToolTip.Tip="聊天">
                    <Grid>
                        <!--  消息图标  -->
                        <Path
                            Width="20"
                            Height="20"
                            Data="M4 4h16v12H5.17L4 17.17V4zm14 10V6H6v8h12zm-8-2h4v-2H10v2zm0-3h6V7H10v2z"
                            Fill="{Binding CurrentNavigation, Converter={StaticResource NavigationForegroundConverter}, ConverterParameter=Chat}" />

                        <!--  新消息红点  -->
                        <Border
                            Width="16"
                            Height="16"
                            Margin="0,-4,-4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Red"
                            CornerRadius="8"
                            IsVisible="{Binding HasNewMessages}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding UnreadCount}" />
                        </Border>
                    </Grid>
                </Button>
            </Border>

            <!--  好友按钮  -->
            <Border
                Width="44"
                Height="44"
                Background="{Binding CurrentNavigation, Converter={StaticResource NavigationBackgroundConverter}, ConverterParameter=Friends}"
                CornerRadius="8">
                <Button
                    Width="44"
                    Height="44"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding SwitchToFriendsCommand}"
                    ToolTip.Tip="好友">
                    <Path
                        Width="20"
                        Height="20"
                        Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                        Fill="{Binding CurrentNavigation, Converter={StaticResource NavigationForegroundConverter}, ConverterParameter=Friends}" />
                </Button>
            </Border>

            <!--  设置按钮  -->
            <Border
                Width="44"
                Height="44"
                Background="{Binding CurrentNavigation, Converter={StaticResource NavigationBackgroundConverter}, ConverterParameter=Settings}"
                CornerRadius="8">
                <Button
                    Width="44"
                    Height="44"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding SwitchToSettingsCommand}"
                    ToolTip.Tip="设置">
                    <Path
                        Width="20"
                        Height="20"
                        Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.82,11.69,4.82,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                        Fill="{Binding CurrentNavigation, Converter={StaticResource NavigationForegroundConverter}, ConverterParameter=Settings}" />
                </Button>
            </Border>

        </StackPanel>

        <!--  底部状态区域  -->
        <StackPanel Grid.Row="2" Spacing="4">

            <!--  连接状态指示  -->
            <Border
                Width="32"
                Height="8"
                Background="{Binding IsConnected, Converter={StaticResource ConnectedColorConverter}}"
                CornerRadius="4" />

            <!--  状态文本  -->
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="8"
                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                Text="{Binding CurrentUser.Status, Converter={StaticResource StatusTextConverter}}" />

        </StackPanel>

    </Grid>

</UserControl>
